<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebotarm_hybrid">
  <xacro:arg name="initial_positions_file" default="$(find rebotarm_moveit_config)/config/initial_positions.yaml"/>

  <xacro:include filename="$(find rebotarm_description)/urdf/rebotarm_with_d435.urdf.xacro"/>
  <xacro:include filename="$(find rebotarm_moveit_config)/config/rebotarm_hybrid.ros2_control.xacro"/>

  <xacro:rebotarm_hybrid_ros2_control name="RebotArmMockSystem" initial_positions_file="$(arg initial_positions_file)"/>
</robot>
