<?xml version="1.0"?>
<robot name="rebotarm_hybrid">
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.0"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <virtual_joint name="FixedBase" type="fixed" parent_frame="world" child_link="base_link"/>

  <disable_collisions link1="cad_base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <!-- 零位的 link2/link4 接触是机械限位。此项对这两个连杆的所有姿态生效。 -->
  <disable_collisions link1="link2" link2="link4" reason="MechanicalLimit"/>
  <!-- 用户确认 link2/link5 也是机械限位接触；仅豁免这一对，所有姿态生效。 -->
  <disable_collisions link1="link2" link2="link5" reason="MechanicalLimit"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <!-- 腕部与夹爪的固定装配面允许接触。 -->
  <disable_collisions link1="link5" link2="gripper_end" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="gripper_end" reason="Adjacent"/>
  <disable_collisions link1="gripper_end" link2="gripper_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_end" link2="gripper_right" reason="Adjacent"/>
  <disable_collisions link1="gripper_end" link2="gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="gripper_end" link2="d435_collision_proxy" reason="MountedSensor"/>
  <disable_collisions link1="gripper_left" link2="gripper_tcp" reason="Never"/>
  <disable_collisions link1="gripper_right" link2="gripper_tcp" reason="Never"/>
  <disable_collisions link1="gripper_left" link2="gripper_right" reason="Never"/>
</robot>
