<?xml version="1.0"?>
<package format="3">
 <name>rebotarm_planning</name><version>0.1.0</version>
 <description>Shared arm kinematics, collision checking and measured trajectory execution.</description>
 <maintainer email="support@example.com">reBotArm Maintainers</maintainer><license>Apache-2.0</license>
 <buildtool_depend>ament_python</buildtool_depend>
 <exec_depend>rclpy</exec_depend><exec_depend>rebotarm_msgs</exec_depend><exec_depend>rebotarm_description</exec_depend>
 <exec_depend>control_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
 <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend><exec_depend>trajectory_msgs</exec_depend>
 <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
 <exec_depend>xacro</exec_depend>
 <exec_depend>ament_index_python</exec_depend>
 <export><build_type>ament_python</build_type></export>
</package>
