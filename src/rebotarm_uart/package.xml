<?xml version="1.0"?>
<package format="3">
  <name>rebotarm_uart</name><version>0.1.0</version>
  <description>ROS 2 UART MIT bridge to STM32.</description>
  <maintainer email="support@example.com">reBotArm Maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rebotarm_msgs</exec_depend>
  <exec_depend>rebotarm_description</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>rebotarm_planning</exec_depend>
  <exec_depend>rebotarm_tasks</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
